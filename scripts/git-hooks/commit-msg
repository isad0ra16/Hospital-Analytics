#!/usr/bin/env bash
# commit-msg hook: commits carry only the author's own identity.
#
# Rejected lines (case-insensitive, comment lines starting with '#' are ignored):
#   * session or tracking references:  "<Something>-Session: ..."
#   * automatic generation notices:    "Generated with ..."
#   * co-author trailers:              "Co-Authored-By: ..."
#     A legitimate co-author can be credited on purpose by committing with
#     ALLOW_CO_AUTHOR=1 (session references and generation notices stay blocked).
#
# Install explicitly with `make hooks`; remove with `make hooks-uninstall`.
set -euo pipefail

message_file="$1"
content=$(grep -v '^#' "$message_file" || true)

problems=$(printf '%s\n' "$content" | grep -inE '^[[:space:]]*([a-z0-9-]+-session:|generated with)' || true)
if [[ "${ALLOW_CO_AUTHOR:-0}" != "1" ]]; then
  co_authors=$(printf '%s\n' "$content" | grep -inE '^[[:space:]]*co-authored-by:' || true)
  problems=$(printf '%s\n%s' "$problems" "$co_authors" | sed '/^$/d')
fi

if [[ -n "$problems" ]]; then
  {
    echo "commit-msg: commit message rejected by the project's commit conventions:"
    printf '%s\n' "$problems" | sed 's/^/  line /'
    echo "Remove these lines. To credit a real co-author on purpose, commit with ALLOW_CO_AUTHOR=1."
    echo "See CONTRIBUTING.md."
  } >&2
  exit 1
fi

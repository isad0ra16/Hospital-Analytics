/// 1 linha por município de residência presente no fato
table dim_municipio_residencia
	lineageTag: 760af864-39e5-5ae5-9612-7c83d40ffb19

	/// Código do município de RESIDÊNCIA (6 dígitos) (origem: MUNIC_RES)
	column municipio_residencia_cod
		dataType: string
		lineageTag: 45455e30-5977-5e1f-a498-e3501c906a78
		summarizeBy: none
		sourceColumn: municipio_residencia_cod

		annotation SummarizationSetBy = User

	/// 2 primeiros dígitos do código do município (origem: MUNIC_RES)
	column uf_residencia_cod
		dataType: string
		lineageTag: 4b6f75a3-557a-5e3b-9a37-2b9c1a72be65
		summarizeBy: none
		sourceColumn: uf_residencia_cod

		annotation SummarizationSetBy = User

	/// Código IBGE de 7 dígitos (origem: IBGE)
	column municipio_residencia_ibge
		dataType: string
		lineageTag: 6d4e1d12-f20d-5de5-beb5-6833deb636e4
		summarizeBy: none
		sourceColumn: municipio_residencia_ibge

		annotation SummarizationSetBy = User

	/// Nome do município de residência (origem: IBGE)
	column municipio_residencia_nome
		dataType: string
		dataCategory: City
		lineageTag: 315c5174-32a9-565a-bb20-d8f734d9a92e
		summarizeBy: none
		sourceColumn: municipio_residencia_nome


	/// UF de residência (sigla) (origem: IBGE)
	column uf_residencia_sigla
		dataType: string
		dataCategory: StateOrProvince
		lineageTag: 55251341-7b2c-5fde-88bf-01bb9b2a26f1
		summarizeBy: none
		sourceColumn: uf_residencia_sigla

		annotation SummarizationSetBy = User

	/// Município (UF) — único; usar nos visuais (origem: IBGE)
	column municipio_residencia_rotulo
		dataType: string
		lineageTag: f9193eae-6f57-54c2-9427-a9a23803e5d2
		summarizeBy: none
		sourceColumn: municipio_residencia_rotulo


/// 1 linha por registro de AIH do arquivo RD (não é paciente nem, necessariamente, internação)
table fato_registro_aih
	lineageTag: 5686b051-4d0d-55cf-ba4a-7f1397b61555

	/// Chave técnica: posição do registro no arquivo (1..n) (origem: ordem física)
	column registro_id
		dataType: int64
		formatString: 0
		isHidden
		lineageTag: 040d0d42-ebf5-57a8-a77d-a1380aaeeeed
		summarizeBy: none
		sourceColumn: registro_id

		annotation SummarizationSetBy = User

	/// Pseudônimo determinístico do N_AIH (posto denso); só para contagem distinta (origem: N_AIH)
	column aih_id

/// 1 linha por código de CAR_INT presente no fato
table dim_carater
	lineageTag: 4bfdb678-ecce-593f-ab1f-4e3220da3d84

	/// Código de caráter da internação (CAR_INT) (origem: CAR_INT)
	column carater_cod
		dataType: string
		lineageTag: 76d957df-58e7-53b1-8b69-d0d23f626dbc
		summarizeBy: none
		sourceColumn: carater_cod

		annotation SummarizationSetBy = User


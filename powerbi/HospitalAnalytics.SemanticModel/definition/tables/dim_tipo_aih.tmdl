/// 1 linha por código de IDENT presente no fato
table dim_tipo_aih
	lineageTag: 75d161bb-1b31-5f78-8081-98fde76979ab

	/// Código de tipo de AIH (IDENT) (origem: IDENT)
	column tipo_aih_cod
		dataType: string
		lineageTag: 5bab8964-4ef1-5db4-b518-368a3d47c29e
		summarizeBy: none
		sourceColumn: tipo_aih_cod

		annotation SummarizationSetBy = User

	/// Descrição do código (tipo de AIH) — fonte secundária (origem: dicionário)
	column descricao
		dataType: string
		displayFolder: Proveniência e fonte secundária
		lineageTag: da9c9499-3fab-5f28-a6ac-93e937cf0192
		summarizeBy: none

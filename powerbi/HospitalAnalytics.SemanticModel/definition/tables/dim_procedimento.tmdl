/// 1 linha por procedimento realizado presente no fato
table dim_procedimento
	lineageTag: 203a465a-fad9-54a6-b6dc-88dd357ea2c9

	/// Código SIGTAP do procedimento realizado (origem: PROC_REA)
	column procedimento_cod
		dataType: string
		lineageTag: e3aa3adf-2e0e-5e91-ad17-2048474df160
		summarizeBy: none
		sourceColumn: procedimento_cod

		annotation SummarizationSetBy = User

	/// Grupo SIGTAP (2 primeiros dígitos) (origem: PROC_REA)
	column grupo_cod
		dataType: string
		lineageTag: a59f0901-b3dc-5bdf-8dfc-42038fdbad90
		summarizeBy: none
